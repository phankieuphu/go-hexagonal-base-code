AWS_REGION=ap-southeast-1
ACCOUNTING_SQS=

ACCOUNT_ENTRY_TABLE=accounting_account_entry

DB_DRIVER=mysql
DB_HOST=localhost
DB_PORT=3306
DB_USERNAME=app
DB_PASSWORD=app_pass
DB_NAME=application
DB_MAX_OPEN_CONNS=25
DB_MAX_IDLE_CONNS=10
DB_CONN_MAX_LIFETIME_SEC=1800

API_PORT=8080
API_READ_TIMEOUT_SEC=30
API_WRITE_TIMEOUT_SEC=30

# Comma-separated list of brokers.
KAFKA_BROKERS=localhost:9092
KAFKA_PRODUCER_TOPIC=account.events
KAFKA_CONSUMER_TOPIC=identity.user-events
KAFKA_CONSUMER_GROUP=account-service

REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

LOG_LEVEL=info
LOG_FORMAT=json
LOG_ADD_SOURCE=false
